<Project TreatAsLocalProperty="HexalithEventStoreVersion;MemoriesEventStoreMinimumVersion">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <HexalithFrontComposerVersion Condition="'$(HexalithFrontComposerVersion)' == ''">6.2.0</HexalithFrontComposerVersion>
    <HexalithCommonsVersion Condition="'$(HexalithCommonsVersion)' == ''">3.0.4</HexalithCommonsVersion>
    <HexalithPolymorphicSerializationsVersion Condition="'$(HexalithPolymorphicSerializationsVersion)' == ''">2.0.3</HexalithPolymorphicSerializationsVersion>
    <HexalithMemoriesVersion Condition="'$(HexalithMemoriesVersion)' == ''">4.1.4</HexalithMemoriesVersion>
    <!-- Define paths of the Hexalith packages props. -->
    <Hexalith1BuildPackageProps>$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props</Hexalith1BuildPackageProps>
    <Hexalith2BuildPackageProps>$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props</Hexalith2BuildPackageProps>
    <Hexalith3BuildPackageProps>$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/Directory.Packages.props</Hexalith3BuildPackageProps>
  </PropertyGroup>
  <!-- Import the required Hexalith.Packages.props file. -->
  <Import Project="$(Hexalith1BuildPackageProps)" Condition="Exists('$(Hexalith1BuildPackageProps)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(Hexalith2BuildPackageProps)" Condition="Exists('$(Hexalith2BuildPackageProps)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(Hexalith3BuildPackageProps)" Condition="'$(HexalithVersionsLoaded)' != 'true'" />
  <!-- Older selected Builds catalogs omit the stable validation pin. Keep the current
       NET11 web host off preview validation assets while newer catalogs own the version. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Validation" Version="11.0.0" Condition="'@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Extensions.Validation'))' == ''" />
  </ItemGroup>
  <!-- Owner release prerequisite: keep newer central selections while requiring the delivered catalog SDK. -->
  <PropertyGroup>
    <MemoriesEventStoreMinimumVersion>5.6.0</MemoriesEventStoreMinimumVersion>
    <HexalithEventStoreVersion Condition="('$(HexalithEventStoreFromSource)' != 'true' or '$(MemoriesPublishedHostedTestProfile)' == 'true') and ('$(HexalithEventStoreVersion)' == '' or $([MSBuild]::VersionLessThan('$(HexalithEventStoreVersion)', '$(MemoriesEventStoreMinimumVersion)')))">$(MemoriesEventStoreMinimumVersion)</HexalithEventStoreVersion>
    <HexalithAspireAppHostSdkVersion>17.0.0</HexalithAspireAppHostSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Update="Hexalith.EventStore.*" Version="$(HexalithEventStoreVersion)" />
  </ItemGroup>
  <!-- Keep the module's Aspire 17 hosting selection. The Builds catalog supplies the Dapr integration version. -->
  <ItemGroup>
    <PackageVersion Update="Aspire.Azure.Messaging.ServiceBus" Version="17.0.0" />
    <PackageVersion Update="Aspire.Azure.Security.KeyVault" Version="17.0.0" />
    <PackageVersion Update="Aspire.Azure.Storage.Blobs" Version="17.0.0" />
    <PackageVersion Update="Aspire.Azure.Storage.Queues" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Azure.AppContainers" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Azure.CosmosDB" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Docker" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Keycloak" Version="17.0.0-preview.1.26567.5" />
    <PackageVersion Update="Aspire.Hosting.Kubernetes" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Redis" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Testing" Version="17.0.0" />
    <PackageVersion Update="Aspire.Microsoft.Azure.Cosmos" Version="17.0.0" />
  </ItemGroup>
  <!-- Existing public compatibility packages are consumed only by the explicit hosted-test profile. -->
  <ItemGroup Condition="'$(HexalithUsePublishedSdkForHostedTests)' == 'true' and '$(IsPublishing)' != 'true'">
    <PackageVersion Include="Hexalith.Memories.ServiceDefaults" Version="$(HexalithMemoriesVersion)" Condition="'@(PackageVersion->WithMetadataValue('Identity', 'Hexalith.Memories.ServiceDefaults'))' == ''" />
    <PackageVersion Include="Hexalith.Memories.Telemetry" Version="$(HexalithMemoriesVersion)" Condition="'@(PackageVersion->WithMetadataValue('Identity', 'Hexalith.Memories.Telemetry'))' == ''" />
  </ItemGroup>
</Project>
