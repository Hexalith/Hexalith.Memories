{
  "schema": "hexalith.module-manifest.v2",
  "modules": [
    {
      "identity": {
        "moduleId": "memories",
        "servers": [
          {
            "id": "server",
            "appId": "memories",
            "resourceId": "memories",
            "enabled": true,
            "required": true
          },
          {
            "id": "clock",
            "appId": "memories-access-telemetry-clock",
            "resourceId": "memories-access-telemetry-clock",
            "enabled": true,
            "required": true
          },
          {
            "id": "telemetry",
            "appId": "memories-access-telemetry",
            "resourceId": "memories-access-telemetry",
            "enabled": true,
            "required": true
          }
        ],
        "dependencies": [
          "eventstore"
        ]
      },
      "runtime": {
        "dapr": [
          {
            "role": "state",
            "capability": "state",
            "recoveryClass": "authoritative-restore",
            "configurationKey": "Dapr:StateStoreComponent"
          },
          {
            "role": "events",
            "capability": "pubsub",
            "recoveryClass": "rebuild-only",
            "configurationKey": "Dapr:PubSubComponent"
          },
          {
            "role": "secrets",
            "capability": "secret",
            "recoveryClass": "live-authority-only",
            "configurationKey": "Dapr:SecretStoreComponent"
          },
          {
            "role": "telemetry-state",
            "capability": "state",
            "recoveryClass": "authoritative-restore",
            "configurationKey": "AccessTelemetryLifecycle:StateStoreComponent"
          },
          {
            "role": "telemetry-secrets",
            "capability": "secret",
            "recoveryClass": "live-authority-only",
            "configurationKey": "AccessTelemetryLifecycle:SecretStoreComponent"
          },
          {
            "role": "telemetry-configuration",
            "capability": "configuration",
            "recoveryClass": "authoritative-restore",
            "configurationKey": "AccessTelemetryLifecycle:ConfigurationComponent"
          }
        ],
        "extensions": [
          {
            "packageId": "Hexalith.Memories.Aspire",
            "configurationInputs": [
              {
                "key": "Memories:LlmComponentPath",
                "source": "configuration",
                "reference": "llmcomponentpath"
              },
              {
                "key": "ConnectionStrings:redis",
                "source": "configuration",
                "reference": "redis"
              },
              {
                "key": "ConnectionStrings:falkordb",
                "source": "configuration",
                "reference": "falkordb"
              },
              {
                "key": "AccessTelemetryLifecycle:StateStoreComponentPath",
                "source": "configuration",
                "reference": "statestorecomponentpath"
              },
              {
                "key": "AccessTelemetryLifecycle:ConfigurationStoreComponentPath",
                "source": "configuration",
                "reference": "configurationstorecomponentpath"
              },
              {
                "key": "Clock:SecretStoreName",
                "source": "configuration",
                "reference": "secretstorename"
              },
              {
                "key": "Clock:SigningKeySecretName",
                "source": "configuration",
                "reference": "signingkeysecretname"
              },
              {
                "key": "Clock:Sources",
                "source": "configuration",
                "reference": "sources"
              },
              {
                "key": "Clock:AllowDevelopmentSources",
                "source": "configuration",
                "reference": "allowdevelopmentsources"
              },
              {
                "key": "AccessTelemetryLifecycle:MarkerKeyReference",
                "source": "configuration",
                "reference": "markerkeyreference"
              },
              {
                "key": "NaturalLanguage:RetryWorkerEnabled",
                "source": "configuration",
                "reference": "retryworkerenabled"
              },
              {
                "key": "Embedding:CredentialNamespace",
                "source": "configuration",
                "reference": "credentialnamespace"
              },
              {
                "key": "OrphanSemanticIndex:Enabled",
                "source": "configuration",
                "reference": "orphan-semantic-index-reconciliation"
              },
              {
                "key": "IsStubBackfill:Enabled",
                "source": "configuration",
                "reference": "is-stub-backfill"
              }
            ]
          }
        ],
        "resources": [
          {
            "server": "server",
            "requests": {},
            "limits": {},
            "volumes": []
          },
          {
            "server": "clock",
            "requests": {},
            "limits": {},
            "volumes": []
          },
          {
            "server": "telemetry",
            "requests": {},
            "limits": {},
            "volumes": []
          }
        ],
        "providerExceptions": [
          {
            "name": "memories-falkordb-graph",
            "capability": "Graph indexing through the FalkorDB provider SDK",
            "owner": "memories",
            "surface": "memories-api",
            "transitional": false
          },
          {
            "name": "memories-redis-search-vector",
            "capability": "Redis search and vector indexing through StackExchange.Redis",
            "owner": "memories",
            "surface": "memories-api",
            "transitional": false
          },
          {
            "name": "memories-set-nx-preflight-dedup",
            "capability": "Redis SET NX preflight deduplication",
            "owner": "memories",
            "surface": "memories-api",
            "transitional": false
          },
          {
            "name": "memories-redis-coordination",
            "capability": "Direct Redis queue and coordination state during migration",
            "owner": "memories",
            "surface": "memories-api",
            "transitional": true
          }
        ]
      },
      "surfaces": {
        "interfaces": [
          {
            "name": "memories-api",
            "server": "server",
            "protocol": "http",
            "routePrefix": "/api/v1",
            "exposure": "public",
            "surfaceClass": "service",
            "authorization": {
              "policy": "authenticated",
              "permissions": []
            },
            "callers": [],
            "operations": [
              {
                "name": "ingest",
                "kind": "command",
                "authorizationPolicy": "authenticated"
              },
              {
                "name": "search",
                "kind": "query",
                "authorizationPolicy": "authenticated"
              },
              {
                "name": "cases",
                "kind": "query",
                "authorizationPolicy": "authenticated"
              },
              {
                "name": "tenant",
                "kind": "command",
                "authorizationPolicy": "authenticated"
              }
            ]
          },
          {
            "name": "clock-attestation",
            "server": "clock",
            "protocol": "http",
            "routePrefix": "/v1/time/attest",
            "exposure": "internal-only",
            "surfaceClass": "service",
            "authorization": {
              "policy": "authenticated",
              "permissions": []
            },
            "callers": [
              "memories",
              "memories-access-telemetry"
            ],
            "operations": [
              {
                "name": "attest",
                "kind": "query",
                "authorizationPolicy": "authenticated"
              }
            ]
          },
          {
            "name": "telemetry-lifecycle",
            "server": "telemetry",
            "protocol": "http",
            "routePrefix": "/v1/access-telemetry",
            "exposure": "internal-only",
            "surfaceClass": "service",
            "authorization": {
              "policy": "authenticated",
              "permissions": []
            },
            "callers": [
              "memories"
            ],
            "operations": [
              {
                "name": "write",
                "kind": "command",
                "authorizationPolicy": "authenticated"
              },
              {
                "name": "heartbeat",
                "kind": "command",
                "authorizationPolicy": "authenticated"
              },
              {
                "name": "inspect",
                "kind": "query",
                "authorizationPolicy": "authenticated"
              }
            ]
          }
        ]
      },
      "integration": {
        "topics": [
          {
            "name": "memories-events",
            "role": "events",
            "deadLetter": {
              "strategy": "none"
            }
          }
        ],
        "secrets": [
          {
            "name": "clock-signing-key",
            "configurationKey": "Clock:SigningKeySecretName"
          },
          {
            "name": "telemetry-marker-key",
            "configurationKey": "AccessTelemetryLifecycle:MarkerKeyReference"
          }
        ],
        "dynamicSecretNamespaces": [
          {
            "name": "embedding-credentials",
            "owner": "memories",
            "configurationKey": "Embedding:CredentialNamespace"
          }
        ],
        "identityNeeds": [],
        "egress": [],
        "providers": [
          {
            "name": "redis-search",
            "capability": "search and vector storage",
            "tenancy": {
              "mode": "per-environment",
              "configurationKey": "ConnectionStrings:redis"
            }
          },
          {
            "name": "falkordb",
            "capability": "graph storage",
            "tenancy": {
              "mode": "per-environment",
              "configurationKey": "ConnectionStrings:falkordb"
            }
          }
        ],
        "workers": [
          {
            "name": "embedding-retry",
            "kind": "external-effect",
            "disableControl": {
              "configurationKey": "NaturalLanguage:RetryWorkerEnabled",
              "disabledValue": false
            }
          },
          {
            "name": "telemetry-delivery",
            "kind": "external-effect",
            "disableControl": {
              "configurationKey": "AccessTelemetryLifecycle:Enabled",
              "disabledValue": false
            }
          },
          {
            "name": "telemetry-heartbeat",
            "kind": "external-effect",
            "disableControl": {
              "configurationKey": "AccessTelemetryLifecycle:Enabled",
              "disabledValue": false
            }
          },
          {
            "name": "telemetry-retention",
            "kind": "destructive-retention",
            "disableControl": {
              "configurationKey": "AccessTelemetryLifecycle:Enabled",
              "disabledValue": false
            }
          },
          {
            "name": "routed-tenant-provisioning",
            "kind": "external-effect",
            "disableControl": {
              "configurationKey": "TenantEventRouting:AutoProvisionRoutedTenants",
              "disabledValue": false
            }
          },
          {
            "name": "orphan-semantic-index-reconciliation",
            "kind": "external-effect",
            "disableControl": {
              "configurationKey": "OrphanSemanticIndex:Enabled",
              "disabledValue": false
            }
          },
          {
            "name": "is-stub-backfill",
            "kind": "external-effect",
            "disableControl": {
              "configurationKey": "IsStubBackfill:Enabled",
              "disabledValue": false
            }
          }
        ]
      },
      "lifecycle": {
        "readiness": [
          {
            "server": "server",
            "kind": "http",
            "endpoint": "/ready"
          },
          {
            "server": "clock",
            "kind": "http",
            "endpoint": "/ready"
          },
          {
            "server": "telemetry",
            "kind": "http",
            "endpoint": "/ready"
          }
        ],
        "tasks": [],
        "recoveryHooks": [],
        "fenceHooks": [],
        "replay": {
          "reopenBeforeReplay": false
        },
        "startup": {},
        "criticalFlows": [
          {
            "name": "ingest-and-search",
            "surface": "memories-api",
            "operations": [
              "ingest",
              "search"
            ]
          }
        ],
        "smokeSurfaces": [],
        "classification": {
          "changeClass": "additive",
          "reason": "Declare Memories core and access telemetry services with explicit provider exceptions."
        },
        "recoveryInventory": []
      }
    }
  ]
}
