@namespace Hexalith.Memories.Web.Components.Evidence
@inject IStringLocalizer<MemoriesWebResources> Localizer

<section class="mem-evidence-section"
         data-testid="mem-source-stack"
         aria-label="@Localizer[EvidenceResourceKeys.SourcesSection]">
    <FluentText data-testid="mem-source-order-basis">
        @Localizer[EvidenceResourceKeys.OrderBasis, OrderBasisText]
    </FluentText>
    @if (IsRestricted)
    {
        <FluentText role="status" data-testid="mem-source-restricted">@Localizer[EvidenceResourceKeys.SourcesRestricted]</FluentText>
    }
    else if (Sources.Count == 0)
    {
        <FluentText role="status">@Localizer[EvidenceResourceKeys.SourcesUnavailable]</FluentText>
    }
    else
    {
        <ol>
            @foreach (EvidencePacketSource source in Sources)
            {
                <li data-testid="mem-source-item" data-source-rank="@source.Rank">
                    <div>
                        <strong>@EvidenceDisplay.SafeText(source.SourceUri, Localizer[EvidenceResourceKeys.SourceUnavailable])</strong>
                        <span>@EvidenceDisplay.Label(source.SourceType, Localizer)</span>
                    </div>
                    <FluentText>@EvidenceDisplay.SafeText(source.Snippet, Localizer[EvidenceResourceKeys.SnippetUnavailable])</FluentText>
                    <dl>
                        <dt>@Localizer[EvidenceResourceKeys.FreshnessField]</dt>
                        <dd>@EvidenceDisplay.FreshnessLabel(source.Freshness ?? Packet.Metadata?.Freshness, Localizer)</dd>
                        <dt>@Localizer[EvidenceResourceKeys.TimestampField]</dt>
                        <dd>@EvidenceDisplay.TimestampLabel(source.Timestamp, Localizer)</dd>
                        <dt>@Localizer[EvidenceResourceKeys.ScoreField]</dt>
                        <dd>@EvidenceDisplay.ScoreLabel(source.Score, Localizer)</dd>
                        <dt>@Localizer[EvidenceResourceKeys.MemoryUnitField]</dt>
                        <dd>@EvidenceDisplay.SafeText(source.MemoryUnitId, Localizer[EvidenceResourceKeys.MemoryUnitUnavailable])</dd>
                    </dl>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter]
    [EditorRequired]
    public EvidencePacket Packet { get; set; } = default!;

    private IReadOnlyList<EvidencePacketSource> Sources => Packet.Sources;

    private bool IsRestricted => EvidenceDisplay.IsRestrictiveScope(Packet.Scope.IsolationStatus)
        || Packet.State == EvidencePacketState.Unauthorized;

    // Advanced Elicitation #4: contract has no ordering signal — preserve packet order
    // and surface that explicitly. When the contract starts emitting an order basis,
    // replace this constant with the contract-sourced value.
    private string OrderBasisText => IsRestricted
        ? Localizer[EvidenceResourceKeys.Unavailable]
        : Localizer[EvidenceResourceKeys.PacketOrder];
}
