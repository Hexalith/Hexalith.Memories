@namespace Hexalith.Memories.Web.Components.Evidence
@inject IStringLocalizer<MemoriesWebResources> Localizer

<section class="mem-trust-strip"
         data-testid="mem-trust-strip"
         data-strip-mode="@Mode"
         aria-label="@Localizer[EvidenceResourceKeys.TrustLabel]">
    <FluentStack Orientation="Orientation.Horizontal"
                 HorizontalGap="8"
                 Wrap="true"
                 VerticalAlignment="VerticalAlignment.Center">
        <FcStatusBadge Slot="@ConfidenceSlot"
                       Label="@ConfidenceLabel"
                       ColumnHeader="@Localizer[EvidenceResourceKeys.ConfidenceColumn]" />
        <FcStatusBadge Slot="BadgeSlot.Neutral"
                       Label="@FreshnessText"
                       ColumnHeader="@Localizer[EvidenceResourceKeys.FreshnessColumn]" />
        <FluentText data-testid="mem-trust-source-count"
                    aria-label="@Localizer[EvidenceResourceKeys.SourceCountLabel, SourceCountText]">
            @SourceCountText
        </FluentText>
        <FcStatusBadge Slot="@HealthSlot"
                       Label="@HealthLabel"
                       ColumnHeader="@Localizer[EvidenceResourceKeys.HealthColumn]" />
        <FcStatusBadge Slot="@TokenBudgetSlot"
                       Label="@TokenBudgetText"
                       ColumnHeader="@Localizer[EvidenceResourceKeys.TokenBudgetColumn]" />
    </FluentStack>
</section>

@code {
    [Parameter]
    [EditorRequired]
    public EvidencePacket Packet { get; set; } = default!;

    [Parameter]
    public TrustStripMode Mode { get; set; } = TrustStripMode.Packet;

    private bool ShowPacketValues => Mode == TrustStripMode.Packet;

    private string ConfidenceLabel => ShowPacketValues
        ? EvidenceDisplay.Label(Packet.Evidence.EvidenceStrength, Localizer)
        : Mode == TrustStripMode.Loading
            ? Localizer[EvidenceResourceKeys.LoadingState]
            : Localizer[EvidenceResourceKeys.Unavailable];

    private BadgeSlot ConfidenceSlot => ShowPacketValues
        ? EvidenceDisplay.SlotForEvidenceStrength(Packet.Evidence.EvidenceStrength)
        : BadgeSlot.Neutral;

    private string HealthLabel => ShowPacketValues
        ? EvidenceDisplay.Label(Packet.State, Localizer)
        : Mode == TrustStripMode.Loading
            ? Localizer[EvidenceResourceKeys.LoadingState]
            : Localizer[EvidenceResourceKeys.Unavailable];

    private BadgeSlot HealthSlot => ShowPacketValues
        ? EvidenceDisplay.SlotForState(Packet.State)
        : BadgeSlot.Neutral;

    private string SourceCountText
    {
        get
        {
            if (!ShowPacketValues
                || EvidenceDisplay.IsRestrictiveScope(Packet.Scope.IsolationStatus)
                || Packet.State == EvidencePacketState.Unauthorized)
            {
                return EvidenceDisplay.SourceCountLabel(0, sourcesAvailable: false, Localizer);
            }

            return EvidenceDisplay.SourceCountLabel(Packet.Sources.Count, sourcesAvailable: true, Localizer);
        }
    }

    private string TokenBudgetText => ShowPacketValues
        ? EvidenceDisplay.TokenBudgetLabel(Packet, Localizer)
        : Localizer[EvidenceResourceKeys.Unavailable];

    private string FreshnessText => ShowPacketValues
        ? EvidenceDisplay.FreshnessLabel(Packet, Localizer)
        : Localizer[EvidenceResourceKeys.Unavailable];

    private BadgeSlot TokenBudgetSlot => ShowPacketValues
        && Packet.OmittedDetails.Reason is EvidencePacketOmissionReason.TokenBudget or EvidencePacketOmissionReason.Combined
        ? BadgeSlot.Warning
        : BadgeSlot.Neutral;

    public enum TrustStripMode
    {
        Packet,
        Loading,
        Error,
    }
}
