@namespace Hexalith.Memories.Web.Components.Evidence
@inject IStringLocalizer<MemoriesWebResources> Localizer

<article class="mem-evidence-cockpit"
         data-testid="mem-evidence-cockpit"
         aria-label="@Localizer[EvidenceResourceKeys.CockpitLabel]">
    <MemoriesScopeHeader Packet="EffectivePacket" />
    <MemoriesTrustStrip Packet="EffectivePacket"
                        Mode="@StripMode" />

    @if (RestrictiveBanner is not null)
    {
        @* Story 17.6 — restrictive precedence banner. The status intent (colour, icon, role styling) now
           comes from the Fluent message primitive instead of hand-authored CSS. The outer container keeps
           the assertive alert live region and the trust contract anchors (data-testid + restrictive kind)
           that Stories 17.1–17.5 and the Epic17 validation suite assert. *@
        <div role="alert"
             aria-live="assertive"
             data-testid="mem-evidence-restrictive-state"
             data-restrictive-kind="@RestrictiveBanner.Kind">
            <FluentMessageBar Intent="@RestrictiveBanner.Intent" AllowDismiss="false">
                @RestrictiveBanner.Message
            </FluentMessageBar>
        </div>
    }

    @if (!HasRealPacket)
    {
        <section class="mem-evidence-result"
                 data-testid="mem-evidence-result"
                 aria-label="@Localizer[EvidenceResourceKeys.ResultLabel]">
            <FluentText Weight="TextWeight.Semibold">@Localizer[EvidenceResourceKeys.ResultSection]</FluentText>
            @if (IsLoading)
            {
                <FluentText role="status" data-testid="mem-evidence-loading">@Localizer[EvidenceResourceKeys.Loading]</FluentText>
            }
            else if (HasError)
            {
                <FluentText role="alert" data-testid="mem-evidence-error">
                    @Localizer[
                        EvidenceResourceKeys.Error,
                        EvidenceDisplay.SafeText(ErrorMessage, Localizer[EvidenceResourceKeys.ReasonRedacted])]
                </FluentText>
            }
            else
            {
                <FluentText role="status" data-testid="mem-evidence-unavailable">@Localizer[EvidenceResourceKeys.Unavailable]</FluentText>
            }
        </section>
    }
    else
    {
        <FluentAccordion ExpandMode="AccordionExpandMode.Multi"
                         HeadingLevel="2"
                         data-testid="mem-evidence-accordion">
            <FluentAccordionItem Header="@Localizer[EvidenceResourceKeys.ResultSection]"
                                 @bind-Expanded="_isEvidenceExpanded"
                                 data-testid="mem-evidence-result-item">
                <section class="mem-evidence-result"
                         data-testid="mem-evidence-result"
                         aria-label="@Localizer[EvidenceResourceKeys.ResultLabel]">
                    <FluentText data-testid="mem-evidence-query">
                        <strong>@Localizer[EvidenceResourceKeys.QueryLabel]:</strong>
                        @EvidenceDisplay.SafeText(EffectivePacket.Result.Query, Localizer[EvidenceResourceKeys.NoQuery])
                    </FluentText>
                    <FluentText data-testid="mem-evidence-summary">
                        @EvidenceDisplay.SafeText(EffectivePacket.Result.Summary, Localizer[EvidenceResourceKeys.SummaryUnavailable])
                    </FluentText>
                </section>
            </FluentAccordionItem>

            <FluentAccordionItem Header="@Localizer[EvidenceResourceKeys.RecoverySection]"
                                 @bind-Expanded="_isRecoveryExpanded"
                                 data-testid="mem-evidence-recovery-item">
                @* Story 17.2 — AnnounceAssertively remains false so the panel does not compete with
                   the precedence banner's assertive alert above. Keep recovery expanded initially so
                   the accordion conversion preserves the previously visible recovery/live-region surface. *@
                <MemoriesRecoveryActionPanel Packet="EffectivePacket"
                                             AnnounceAssertively="false"
                                             OnRecoveryAction="OnRecoveryAction" />
            </FluentAccordionItem>

            @if (ShouldComposeEvidenceChildren)
            {
                <FluentAccordionItem Header="@Localizer[EvidenceResourceKeys.SourcesSection]"
                                     data-testid="mem-evidence-sources-item">
                    <MemoriesSourceCitationStack Packet="EffectivePacket" />
                </FluentAccordionItem>
                <FluentAccordionItem Header="@Localizer[EvidenceResourceKeys.AxesSection]"
                                     data-testid="mem-evidence-axes-item">
                    <MemoriesRetrievalAxisBreakdown Packet="EffectivePacket" />
                </FluentAccordionItem>
                <FluentAccordionItem Header="@Localizer[EvidenceResourceKeys.GraphSection]"
                                     data-testid="mem-evidence-graph-item">
                    <MemoriesGraphPathSummary Packet="EffectivePacket" />
                </FluentAccordionItem>
            }
        </FluentAccordion>
    }
</article>

@code {
    [Parameter]
    public EvidencePacket? Packet { get; set; }

    [Parameter]
    public string TenantId { get; set; } = string.Empty;

    [Parameter]
    public string? CaseId { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    /// <summary>
    /// Gets or sets the callback raised when the operator chooses a recovery action in the panel. The
    /// host routes the emitted intent through existing command, navigation, or handler conventions.
    /// </summary>
    [Parameter]
    public EventCallback<RecoveryActionInvocation> OnRecoveryAction { get; set; }

    private const string UnknownTenantId = "unknown";

    private EvidencePacket? _cachedUnavailablePacket;
    private string? _cachedUnavailableTenantId;
    private string? _cachedUnavailableCaseId;
    private bool _cachedUnavailableIsError;
    private bool _isEvidenceExpanded = true;
    private bool _isRecoveryExpanded = true;

    private EvidencePacket EffectivePacket => Packet ?? GetUnavailablePacket();

    private MemoriesTrustStrip.TrustStripMode StripMode
        => IsLoading
            ? MemoriesTrustStrip.TrustStripMode.Loading
            : !string.IsNullOrWhiteSpace(ErrorMessage)
                ? MemoriesTrustStrip.TrustStripMode.Error
                : MemoriesTrustStrip.TrustStripMode.Packet;

    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);

    private bool HasRealPacket => Packet is not null && !IsLoading && !HasError;

    private bool ShouldComposeEvidenceChildren => HasRealPacket
        && !EvidenceDisplay.IsRestrictiveScope(EffectivePacket.Scope.IsolationStatus)
        && EffectivePacket.State is not EvidencePacketState.Unauthorized;

    private RestrictiveBannerView? RestrictiveBanner => HasRealPacket
        ? ResolveRestrictiveBanner(EffectivePacket)
        : null;

    private EvidencePacket GetUnavailablePacket()
    {
        bool hasError = HasError;
        string effectiveTenantId = string.IsNullOrWhiteSpace(TenantId)
            ? UnknownTenantId
            : TenantId;
        string? effectiveCaseId = string.IsNullOrWhiteSpace(CaseId) ? null : CaseId;
        if (_cachedUnavailablePacket is not null
            && string.Equals(_cachedUnavailableTenantId, effectiveTenantId, StringComparison.Ordinal)
            && string.Equals(_cachedUnavailableCaseId, effectiveCaseId, StringComparison.Ordinal)
            && _cachedUnavailableIsError == hasError)
        {
            return _cachedUnavailablePacket;
        }

        _cachedUnavailablePacket = EvidencePacketMapper.Unavailable(effectiveTenantId, effectiveCaseId, isError: hasError);
        _cachedUnavailableTenantId = effectiveTenantId;
        _cachedUnavailableCaseId = effectiveCaseId;
        _cachedUnavailableIsError = hasError;
        return _cachedUnavailablePacket;
    }

    private RestrictiveBannerView? ResolveRestrictiveBanner(EvidencePacket packet)
    {
        // Restrictive precedence ladder (Advanced Elicitation #3): unauthorized > schema-mismatch / missing-source
        // > redacted/compressed > degraded/partial > supported. Only the most restrictive banner renders.
        if (EvidenceDisplay.IsRestrictiveScope(packet.Scope.IsolationStatus) || packet.State == EvidencePacketState.Unauthorized)
        {
            return new RestrictiveBannerView("unauthorized", Localizer[EvidenceResourceKeys.UnauthorizedBanner], MessageBarIntent.Error);
        }

        if (packet.Evidence.Degraded || packet.Evidence.AllEnabledAxesUnavailable == true)
        {
            return new RestrictiveBannerView("missing-source", Localizer[EvidenceResourceKeys.MissingSourceBanner], MessageBarIntent.Warning);
        }

        if (packet.OmittedDetails.Reason is EvidencePacketOmissionReason.Redaction or EvidencePacketOmissionReason.Policy)
        {
            return new RestrictiveBannerView("redacted", Localizer[EvidenceResourceKeys.RedactedBanner], MessageBarIntent.Warning);
        }

        if (packet.OmittedDetails.Reason is EvidencePacketOmissionReason.TokenBudget or EvidencePacketOmissionReason.Combined)
        {
            return new RestrictiveBannerView("compressed", Localizer[EvidenceResourceKeys.CompressedBanner], MessageBarIntent.Warning);
        }

        if (packet.State is EvidencePacketState.Degraded
            or EvidencePacketState.Partial
            or EvidencePacketState.Weak
            or EvidencePacketState.Stale
            or EvidencePacketState.Empty)
        {
            return new RestrictiveBannerView(
                "degraded",
                Localizer[EvidenceResourceKeys.DegradedBanner, EvidenceDisplay.Label(packet.State, Localizer)],
                MessageBarIntent.Warning);
        }

        return null;
    }

    // Story 17.6 — Kind/Message preserve the existing trust contract; Intent maps the restrictive precedence
    // to a Fluent message intent (unauthorized = Error/red, every other restrictive state = Warning/amber),
    // matching the danger/warning palette the deleted .mem-evidence-restrictive CSS used to hand-author.
    private sealed record RestrictiveBannerView(string Kind, string Message, MessageBarIntent Intent);
}
