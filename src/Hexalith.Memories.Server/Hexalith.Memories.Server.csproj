<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Story 9.2 Task 1.3 / Risk #1: Dapr.AI 1.17.6 marks ConverseAsync [Experimental("DAPR_CONVERSATION")];
         suppress this diagnostic locally so TreatWarningsAsErrors=true does not break the build.
         MUST remain scoped to this project — keep OUT of Directory.Build.props so any other project that
         accidentally takes a Dapr.AI dependency still fails fast. Remove when Dapr.AI exits alpha. -->
    <NoWarn>$(NoWarn);DAPR_CONVERSATION</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Memories.Server.Tests" />
    <InternalsVisibleTo Include="Hexalith.Memories.Benchmarks" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Memories.Contracts\Hexalith.Memories.Contracts.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.EventStore\Hexalith.Memories.EventStore.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.Redis\Hexalith.Memories.Redis.csproj" />
    <ProjectReference
      Include="..\Hexalith.Memories.ServiceDefaults\Hexalith.Memories.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.Telemetry\Hexalith.Memories.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ByteAether.Ulid" />
    <PackageReference Include="Dapr.AspNetCore" />
    <PackageReference Include="Dapr.Client" />
    <PackageReference Include="Dapr.Workflow" />
    <PackageReference Include="Dapr.Actors" />
    <PackageReference Include="Dapr.Actors.AspNetCore" />
    <PackageReference Include="Dapr.AI" />
    <PackageReference Include="Dapr.AI.Microsoft.Extensions" />
    <PackageReference Include="Kreuzberg" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>