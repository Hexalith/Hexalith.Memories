<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Memories-owned local internal EventStore intent adapter enrollment.</Description>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <PackageId>Hexalith.Memories.EventStoreExtensions</PackageId>
    <Authors>ITANEO</Authors>
    <Company>ITANEO</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Memories</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Memories</RepositoryUrl>
    <PackageTags>hexalith;memories;eventstore;routing;idempotency</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hexalith.Memories.EventStore/Hexalith.Memories.EventStore.csproj" />
    <ProjectReference Include="$(HexalithEventStoreRoot)/src/Hexalith.EventStore.DomainService/Hexalith.EventStore.DomainService.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.DomainService" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
