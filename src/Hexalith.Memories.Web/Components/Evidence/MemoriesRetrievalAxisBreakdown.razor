@namespace Hexalith.Memories.Web.Components.Evidence

<section class="mem-evidence-section"
         data-testid="mem-axis-breakdown"
         aria-label="Retrieval axis breakdown">
    <h3>Retrieval axes</h3>
    <p data-testid="mem-axis-order-basis">Order basis: @OrderBasisText</p>
    @if (IsRestricted)
    {
        <p role="status" data-testid="mem-axis-restricted">Axis evidence is not available in the current scope.</p>
    }
    else if (Packet.Evidence.AxisEvidence.Count == 0)
    {
        <p role="status">Axis evidence unavailable</p>
    }
    else
    {
        <ol>
            @foreach (EvidencePacketAxisEvidence axis in Packet.Evidence.AxisEvidence)
            {
                <li data-testid="mem-axis-item" data-axis="@axis.Axis">
                    <strong>@EvidenceDisplay.SafeText(axis.Axis, "axis unavailable")</strong>
                    <dl>
                        <dt>Normalized score</dt>
                        <dd>@EvidenceDisplay.ScoreLabel(axis.Score)</dd>
                        <dt>Ranking reason</dt>
                        <dd>@EvidenceDisplay.SafeText(axis.Description, "ranking reason unavailable")</dd>
                        <dt>Normalization</dt>
                        <dd>@EvidenceDisplay.SafeText(axis.NormalizationMethod, "normalization unavailable")</dd>
                    </dl>
                </li>
            }
        </ol>
    }
    @if (!IsRestricted && Packet.Evidence.UnavailableAxes.Count > 0)
    {
        <p role="status">Unavailable axes: @EvidenceDisplay.SafeText(string.Join(", ", Packet.Evidence.UnavailableAxes), "no unavailable axes")</p>
    }
    @if (!IsRestricted && !string.IsNullOrWhiteSpace(Packet.Evidence.Caveat))
    {
        <p data-testid="mem-axis-caveat">@EvidenceDisplay.SafeText(Packet.Evidence.Caveat, "no caveat")</p>
    }
</section>

@code {
    [Parameter]
    [EditorRequired]
    public EvidencePacket Packet { get; set; } = default!;

    private bool IsRestricted => EvidenceDisplay.IsRestrictiveScope(Packet.Scope.IsolationStatus)
        || Packet.State == EvidencePacketState.Unauthorized;

    private string OrderBasisText => IsRestricted ? "unavailable" : "packet order";
}
