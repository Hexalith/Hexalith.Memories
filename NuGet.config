<?xml version="1.0" encoding="utf-8"?>
<!--
  Story 8.5 ADR-8.5-001 (b) — NuGet package source mapping + signature enforcement.
  Pins all OpenTelemetry.* packages (core + instrumentation + exporters) to the official
  nuget.org source. Rationale: the `OpenTelemetry.Instrumentation.StackExchangeRedis
  1.15.1-beta.1` prerelease pin widens the typosquat-adjacent supply-chain attack surface during
  the `-beta.N` window. Source-mapping forecloses the package-cache-poisoning route that a
  malicious `OpenTelemetry.Instrumentation.*.Extensions` upload could otherwise exploit via a
  future secondary feed.

  The wildcard pattern below already routes to nuget.org today; keeping an explicit
  OpenTelemetry.* pin means a future developer who introduces a secondary feed CANNOT route an
  OpenTelemetry.Instrumentation.* package anywhere other than nuget.org without editing this file.

  Signature validation is required here as well. The `trustedSigners` block pins the CURRENT
  nuget.org repository certificates published in the official NuGet docs. If nuget.org rotates
  those repository certificates, refresh this block from the docs (or sync via
  `nuget trusted-signers sync -Name nuget.org`) before the next restore.
-->
<configuration>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="OpenTelemetry" />
      <package pattern="OpenTelemetry.*" />
    </packageSource>
  </packageSourceMapping>

  <trustedSigners>
    <clear />
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D"
        hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4"
        hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D"
        hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>