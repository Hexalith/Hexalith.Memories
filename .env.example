# Local placeholder for development secrets and test settings.
# The current AppHost reads `secrets.json` via the Dapr `secretstore` component.
GOOGLE_EMBEDDING_API_KEY=YOUR_KEY_HERE

# Optional Dapr token mode for non-local environments.
# Leave disabled for normal local development unless you are validating sidecar token auth.
DAPR_API_TOKEN_MODE=disabled
DAPR_API_TOKEN=replace-with-dapr-api-token
APP_API_TOKEN=replace-with-app-api-token

# Optional Story 6.4 override for the durable Redis data volume name.
# MEMORIES_REDIS_VOLUME_NAME=hexalith-memories-redis-data

# Local test defaults used by the framework scaffold.
TEST_ENV=local
BASE_URL=http://localhost:5000
API_URL=http://localhost:5000
