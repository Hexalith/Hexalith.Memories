@namespace Hexalith.Memories.Web.Components.Evidence
@inject IStringLocalizer<MemoriesWebResources> Localizer

<section class="mem-evidence-section"
         data-testid="mem-axis-breakdown"
         aria-label="@Localizer[EvidenceResourceKeys.AxesSection]">
    <FluentText data-testid="mem-axis-order-basis">
        @Localizer[EvidenceResourceKeys.OrderBasis, OrderBasisText]
    </FluentText>
    @if (IsRestricted)
    {
        <FluentText role="status" data-testid="mem-axis-restricted">@Localizer[EvidenceResourceKeys.AxesRestricted]</FluentText>
    }
    else if (Packet.Evidence.AxisEvidence.Count == 0)
    {
        <FluentText role="status">@Localizer[EvidenceResourceKeys.AxesUnavailable]</FluentText>
    }
    else
    {
        <ol>
            @foreach (EvidencePacketAxisEvidence axis in Packet.Evidence.AxisEvidence)
            {
                <li data-testid="mem-axis-item" data-axis="@axis.Axis">
                    <strong>@EvidenceDisplay.SafeText(axis.Axis, Localizer[EvidenceResourceKeys.AxisUnavailable])</strong>
                    <dl>
                        <dt>@Localizer[EvidenceResourceKeys.NormalizedScoreField]</dt>
                        <dd>@EvidenceDisplay.ScoreLabel(axis.Score, Localizer)</dd>
                        <dt>@Localizer[EvidenceResourceKeys.RankingReasonField]</dt>
                        <dd>@EvidenceDisplay.SafeText(axis.Description, Localizer[EvidenceResourceKeys.RankingReasonUnavailable])</dd>
                        <dt>@Localizer[EvidenceResourceKeys.NormalizationField]</dt>
                        <dd>@EvidenceDisplay.SafeText(axis.NormalizationMethod, Localizer[EvidenceResourceKeys.NormalizationUnavailable])</dd>
                    </dl>
                </li>
            }
        </ol>
    }
    @if (!IsRestricted && Packet.Evidence.UnavailableAxes.Count > 0)
    {
        <FluentText role="status">@Localizer[EvidenceResourceKeys.UnavailableAxes, EvidenceDisplay.SafeText(string.Join(", ", Packet.Evidence.UnavailableAxes), Localizer[EvidenceResourceKeys.NoUnavailableAxes])]</FluentText>
    }
    @if (!IsRestricted && !string.IsNullOrWhiteSpace(Packet.Evidence.Caveat))
    {
        <FluentText data-testid="mem-axis-caveat">@EvidenceDisplay.SafeText(Packet.Evidence.Caveat, Localizer[EvidenceResourceKeys.NoCaveat])</FluentText>
    }
</section>

@code {
    [Parameter]
    [EditorRequired]
    public EvidencePacket Packet { get; set; } = default!;

    private bool IsRestricted => EvidenceDisplay.IsRestrictiveScope(Packet.Scope.IsolationStatus)
        || Packet.State == EvidencePacketState.Unauthorized;

    private string OrderBasisText => IsRestricted
        ? Localizer[EvidenceResourceKeys.Unavailable]
        : Localizer[EvidenceResourceKeys.PacketOrder];
}
