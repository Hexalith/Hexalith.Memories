<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Keep the NuGet vulnerability audit enabled but non-fatal for the four audit warning
         codes, so a transitive advisory we cannot immediately upgrade (e.g. the AngleSharp/bunit
         NU1902 chain, GHSA-pgww-w46g-26qg) surfaces in build logs without blocking CI (Hexalith
         ci-cd-standards.md, "Dependency Auditing"). Matches Hexalith.Builds/Hexalith.EventStore/
         Hexalith.Tenants. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Resolve dependent submodules under references/ when initialized, otherwise to the
         sibling checkout in the parent repository (mirrors the Hexalith*Root pattern). -->
    <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.FrontComposer\src\Hexalith.FrontComposer.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.FrontComposer</HexalithFrontComposerRoot>
    <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\references\Hexalith.FrontComposer\src\Hexalith.FrontComposer.Contracts')">$(MSBuildThisFileDirectory)..\references\Hexalith.FrontComposer</HexalithFrontComposerRoot>
    <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.FrontComposer\src\Hexalith.FrontComposer.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.FrontComposer</HexalithFrontComposerRoot>
    <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.FrontComposer.slnx') and Exists('$(MSBuildThisFileDirectory)..\src\Hexalith.FrontComposer.Contracts')">$(MSBuildThisFileDirectory)..</HexalithFrontComposerRoot>
    <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Hexalith.FrontComposer.slnx') and Exists('$(MSBuildThisFileDirectory)..\..\src\Hexalith.FrontComposer.Contracts')">$(MSBuildThisFileDirectory)..\..</HexalithFrontComposerRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.EventStore\src\Hexalith.EventStore.Aspire')">$(MSBuildThisFileDirectory)references\Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\references\Hexalith.EventStore\src\Hexalith.EventStore.Aspire')">$(MSBuildThisFileDirectory)..\references\Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.EventStore\src\Hexalith.EventStore.Aspire')">$(MSBuildThisFileDirectory)..\Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.EventStore.slnx') and Exists('$(MSBuildThisFileDirectory)..\src\Hexalith.EventStore.Aspire')">$(MSBuildThisFileDirectory)..</HexalithEventStoreRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Hexalith.EventStore.slnx') and Exists('$(MSBuildThisFileDirectory)..\..\src\Hexalith.EventStore.Aspire')">$(MSBuildThisFileDirectory)..\..</HexalithEventStoreRoot>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Cross-repo Hexalith dependencies use centrally pinned NuGet packages by default
         so plain restore/build graphs stay consistent for Release. Override
         UseHexalithProjectReferences=true or UseNuGetDeps=false only for intentional
         source-debug sessions. -->
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == 'true'">false</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == 'false'">true</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(Configuration)' == ''">false</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == ''">false</UseHexalithProjectReferences>
    <UseNuGetDeps Condition="'$(UseNuGetDeps)' == '' and '$(UseHexalithProjectReferences)' == 'true'">false</UseNuGetDeps>
    <UseNuGetDeps Condition="'$(UseNuGetDeps)' == ''">true</UseNuGetDeps>
    <HexalithFrontComposerFromSource Condition="'$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithFrontComposerRoot)\src\Hexalith.FrontComposer.Contracts\Hexalith.FrontComposer.Contracts.csproj')">true</HexalithFrontComposerFromSource>
    <HexalithEventStoreFromSource Condition="'$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Aspire\Hexalith.EventStore.Aspire.csproj')">true</HexalithEventStoreFromSource>
  </PropertyGroup>

  <PropertyGroup>
    <!-- When Hexalith.Memories is consumed as a submodule of the Hexalith.Tenants repository, the
         parent repo IS Hexalith.Tenants (its .slnx sits one level up), so a separate Hexalith.Tenants
         submodule is neither present nor required. Detect that layout and drop the requirement; the
         standalone-Memories layout (where Hexalith.Tenants is a real nested/sibling submodule) is
         unaffected. -->
    <HexalithMemoriesHostedInTenantsRepo Condition="'$(HexalithMemoriesHostedInTenantsRepo)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Tenants.slnx')">true</HexalithMemoriesHostedInTenantsRepo>
    <HexalithMemoriesHostedInTenantsRepo Condition="'$(HexalithMemoriesHostedInTenantsRepo)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Hexalith.Tenants.slnx')">true</HexalithMemoriesHostedInTenantsRepo>
    <HexalithMemoriesHostedInFrontComposerRepo Condition="'$(HexalithMemoriesHostedInFrontComposerRepo)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.FrontComposer.slnx')">true</HexalithMemoriesHostedInFrontComposerRepo>
    <HexalithMemoriesHostedInFrontComposerRepo Condition="'$(HexalithMemoriesHostedInFrontComposerRepo)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Hexalith.FrontComposer.slnx')">true</HexalithMemoriesHostedInFrontComposerRepo>
  </PropertyGroup>

  <!-- Detect missing root-declared git submodules under references/. -->
  <ItemGroup>
    <RequiredRootSubmodule Include="references/Hexalith.Commons">
      <RootName>Hexalith.Commons</RootName>
    </RequiredRootSubmodule>
    <RequiredRootSubmodule Include="references/Hexalith.EventStore">
      <RootName>Hexalith.EventStore</RootName>
    </RequiredRootSubmodule>
    <RequiredRootSubmodule Include="references/Hexalith.AI.Tools">
      <RootName>Hexalith.AI.Tools</RootName>
    </RequiredRootSubmodule>
    <RequiredRootSubmodule Include="references/Hexalith.Tenants" Condition="'$(HexalithMemoriesHostedInTenantsRepo)' != 'true'">
      <RootName>Hexalith.Tenants</RootName>
    </RequiredRootSubmodule>
    <RequiredRootSubmodule Include="references/Hexalith.FrontComposer" Condition="'$(HexalithMemoriesHostedInFrontComposerRepo)' != 'true'">
      <RootName>Hexalith.FrontComposer</RootName>
    </RequiredRootSubmodule>
    <RequiredRootSubmodule Include="references/Hexalith.Builds">
      <RootName>Hexalith.Builds</RootName>
    </RequiredRootSubmodule>
    <RequiredRootSubmodule Include="references/Hexalith.PolymorphicSerializations">
      <RootName>Hexalith.PolymorphicSerializations</RootName>
    </RequiredRootSubmodule>
  </ItemGroup>

  <Target Name="CheckSubmodules" BeforeTargets="Restore;Build" Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <Error
      Condition="!Exists('$(MSBuildThisFileDirectory)%(RequiredRootSubmodule.Identity)/.git') and !Exists('$(MSBuildThisFileDirectory)../%(RequiredRootSubmodule.Identity)/.git') and !Exists('$(MSBuildThisFileDirectory)../%(RequiredRootSubmodule.RootName)/.git')"
      Text="Git submodule '%(RequiredRootSubmodule.Identity)' is missing. Run: git submodule update --init %(RequiredRootSubmodule.Identity) from the repository root." />
  </Target>

  <Target Name="FailReleaseWithHexalithProjectReferences" BeforeTargets="Restore;Build" Condition="'$(Configuration)' != 'Debug' and '$(UseHexalithProjectReferences)' == 'true'">
    <Error Text="Release builds must use NuGet package references for external Hexalith libraries. Remove -p:UseHexalithProjectReferences=true or build Debug for source-debugging." />
  </Target>

  <Target Name="FailPackWithHexalithProjectReferences" BeforeTargets="GenerateNuspec;Pack;Publish" Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <Error Text="Package publication must not use external Hexalith project references. Run pack/publish with UseHexalithProjectReferences=false." />
  </Target>
</Project>
