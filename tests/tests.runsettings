<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Test timeout: 30 seconds per test (unit), override per-collection for integration -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/Program.cs,**/obj/**</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,ObsoleteAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <!-- Filter integration tests out of default runs -->
  <!-- Usage:
    Fast (unit only):       dotnet test - -filter "Category!=Integration"
    Integration only:       dotnet test - -filter "Category=Integration"
    All:                    dotnet test
  -->
</RunSettings>
