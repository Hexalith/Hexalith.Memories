{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "pwsh -NoLogo -NoProfile -File ./tools/pack-release.ps1 -Version ${nextRelease.version} -OutputDirectory ./artifacts/packages/release",
        "publishCmd": "pwsh -NoLogo -NoProfile -File ./tools/publish-release.ps1 -Version ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": ["artifacts/packages/release/*.nupkg", "artifacts/deployment/hexalith-memories-production.yaml"]
      }
    ]
  ]
}
