{
  "name": "hexalith-memories-release",
  "private": true,
  "scripts": {
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "verify:semantic-release-config": "node ./tools/verify-semantic-release-config.mjs && node ./tools/verify-semantic-release-config.mjs --self-test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "cosmiconfig": "10.0.1",
    "semantic-release": "25.0.9"
  },
  "overrides": {
    "fast-uri": "4.2.3",
    "js-yaml": "5.5.0",
    "semantic-release": {
      "@semantic-release/npm": "npm:@semantic-release/error@4.0.0"
    }
  }
}
