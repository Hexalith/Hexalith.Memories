+    [Fact]
+    public void BothSemanticSchemas_HaveIdenticalVectorFieldShape()
+    {
+        Schema raw = IndexSchemaDefinitions.CreateSemanticSchema(768);
+        Schema nl = IndexSchemaDefinitions.CreateNaturalLanguageSemanticSchema(768);
