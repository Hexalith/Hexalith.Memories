#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
git_dir="$(git rev-parse --git-dir)"
cd "$repo_root"

branch_name="$(git branch --show-current)"
message_file="$1"
changed_file="$git_dir/story-scope-changed-$$.txt"
trap 'rm -f "$changed_file"' EXIT

git diff --cached --name-only -- > "$changed_file"

# Conventional Commits gate. semantic-release derives the version and changelog solely from
# commit subjects, so a malformed message silently breaks releases. Runs before the trailer
# gates below so a format failure surfaces first, and mirrors the CI commitlint workflow.
commitlint_bin="$repo_root/node_modules/.bin/commitlint"
if [ -x "$commitlint_bin" ]; then
  if ! "$commitlint_bin" --edit "$message_file"; then
    echo "commit-msg: message failed commitlint. Rewrite it; do not bypass with --no-verify." >&2
    exit 1
  fi
else
  echo "commit-msg: commitlint not found at node_modules/.bin/commitlint; run 'npm ci' to enable the local Conventional Commits gate. CI still enforces it." >&2
fi

if command -v python3 >/dev/null 2>&1; then
  py=python3
else
  py=python
fi

"$py" tools/check-story-file-scope.py --branch-name "$branch_name" --commit-message-file "$message_file" --changed-files-file "$changed_file"

# Cross-tenant negative evidence gate. Runs here (not pre-commit) because the
# bypass/Story trailers live in the commit message, which pre-commit cannot see.
"$py" tools/check-tenant-isolation-evidence.py --branch-name "$branch_name" --commit-message-file "$message_file" --changed-files-file "$changed_file"

# Story review-readiness gate. Runs here for the same trailer reason as the
# gates above. --derive-cumulative anchors C1 on the story's baseline_commit,
# because the staged set is one commit's files, not the story's cumulative diff.
"$py" tools/check-story-review-readiness.py --branch-name "$branch_name" --commit-message-file "$message_file" --changed-files-file "$changed_file" --derive-cumulative
