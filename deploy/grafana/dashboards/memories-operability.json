        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(memories_ingestion_documents_total{tenant_id=~\"$tenant_id\"}[5m]))",
          "legendFormat": "{{tenant_id}}"
        }
      ],
      "title": "Ingestion Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
