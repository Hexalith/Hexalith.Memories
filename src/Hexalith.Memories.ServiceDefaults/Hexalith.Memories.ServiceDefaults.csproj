<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAspireSharedProject>true</IsAspireSharedProject>
    <PackageId>Hexalith.Memories.ServiceDefaults</PackageId>
    <Description>Shared health, resilience, service discovery, and OpenTelemetry defaults for Hexalith.Memories services.</Description>
    <Authors>ITANEO</Authors>
    <Company>ITANEO</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Memories</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Memories</RepositoryUrl>
    <PackageTags>hexalith;memories;aspire;service-defaults;opentelemetry;health-checks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- OpenTelemetry.Instrumentation.StackExchangeRedis is intentionally pinned to a prerelease
         version in Directory.Packages.props. Keep NU5104 scoped to this package and remove the
         suppression when a compatible stable instrumentation release is selected centrally. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Story 8.5 — grant test assemblies access to the internal Redis OTEL registration
         surface so Tier-2 registration tests can pin the flush-interval invariant and assert
         the DI-guard eager-fail path without going through a reflection shim. -->
    <InternalsVisibleTo Include="Hexalith.Memories.Server.Tests" />
    <InternalsVisibleTo Include="Hexalith.Memories.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Memories.Contracts\Hexalith.Memories.Contracts.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.Telemetry\Hexalith.Memories.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <!-- Story 8.5: Redis client instrumentation — registered in ConfigureOpenTelemetry for
         both keyed IConnectionMultiplexer instances ('redis' + 'falkordb'). -->
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
