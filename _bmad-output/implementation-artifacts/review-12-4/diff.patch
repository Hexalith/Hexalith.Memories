+def section_block(stdout: str, header: str) -> list[str]:
+    """Return the bullet lines under `header:` until the next section header."""
+    lines = stdout.splitlines()
+    block: list[str] = []
+    in_section = False
+    for line in lines:
+        if line.strip() == header:
+            in_section = True
+            continue
+        if in_section:
+            if not line.startswith("  - "):
+                break
+            block.append(line[4:])
+    return block
