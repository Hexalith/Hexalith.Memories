<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Hexalith.Memories.Mcp</PackageId>
    <Description>MCP Server surface for Hexalith.Memories (LLM agent interface — Phase 1.5). Exposes
      search_memory / ingest_content / traverse_relations / get_case_info tools over the Streamable
      HTTP transport defined by the Model Context Protocol. Story 10.1.</Description>
    <Authors>ITANEO</Authors>
    <Company>ITANEO</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Memories</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Memories</RepositoryUrl>
    <PackageTags>hexalith;memories;mcp;modelcontextprotocol;llm;agent;dapr</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Memories.Mcp.Tests" />
    <InternalsVisibleTo Include="Hexalith.Memories.IntegrationTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Memories.Contracts\Hexalith.Memories.Contracts.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.Client.Rest\Hexalith.Memories.Client.Rest.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.ServiceDefaults\Hexalith.Memories.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.Telemetry\Hexalith.Memories.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Dapr.AspNetCore" />
    <PackageReference Include="Dapr.Client" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
