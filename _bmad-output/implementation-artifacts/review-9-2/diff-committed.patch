+            CreateInput());
+
+        result.Backend.ShouldBe("semantic-nl");
+        result.MemoryUnitId.ShouldBe("mu-001");
+        result.TenantId.ShouldBe("tenant-a");
+
+        await db.Received(1).HashSetAsync(
+            Arg.Is<RedisKey>(k => k.ToString() == "tenant-a:vec:nl:mu-001"),
+            Arg.Any<HashEntry[]>(),
