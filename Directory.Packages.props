<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Hexalith Commons dependencies -->
    <PackageVersion Include="ByteAether.Ulid" Version="1.3.7" />
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.5" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <!-- Story 8.5: OpenTelemetry stack pinned to 1.15.x. The Redis instrumentation
         (1.15.1-beta.1) transitively requires OpenTelemetry.Api.ProviderBuilderExtensions
         [1.15.3, 2.0.0), so the core + instrumentation + exporter versions move in lock-step.
         Story 10.1: bumped 1.15.1 → 1.15.3 to clear the NU1902 advisories
         (GHSA-mr8r-92fq-pj8p and GHSA-q834-8qmm-v933) on
         OpenTelemetry.Exporter.OpenTelemetryProtocol. Patch-only upgrade — same 1.15 minor,
         same lock-step set; 1.15.3 already matched the StackExchange.Redis transitive floor. -->
    <PackageVersion Include="OpenTelemetry" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <!-- AspNetCore instrumentation latest is 1.15.2; the broader OTel stack moved to 1.15.3
         but AspNetCore has not had a 1.15.3 release. NU1902 advisories targeted the exporter,
         not this package, so 1.15.2 stays acceptable. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <!-- Story 8.5: StackExchange.Redis OTEL instrumentation. Prerelease `-beta.N` tag accepted
         explicitly per ADR-8.5-001 (b); upgrade-on-GA trigger tracked in deferred-work.md. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.15.1-beta.2" />
    <!-- Story 7.5: in-memory OTLP exporter for Tier-2 trace-propagation tests. Bumped to 1.15.3
         alongside the rest of the OTel core/exporter stack (Story 10.1 NU1902 sweep). -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.16.0" />
    <!-- DAPR Aspire Hosting -->
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Dapr" Version="13.4.0-preview.1.260602-0230" />
    <!-- Story 10.1: Model Context Protocol C# SDK 1.2.0 (Microsoft-collaboration release).
         Used by Hexalith.Memories.Mcp to host the LLM-agent tool surface over Streamable HTTP. -->
    <PackageVersion Include="ModelContextProtocol" Version="1.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <!-- DAPR SDKs -->
    <PackageVersion Include="Dapr.AspNetCore" Version="1.18.4" />
    <PackageVersion Include="Dapr.Client" Version="1.18.4" />
    <PackageVersion Include="Dapr.Workflow" Version="1.18.4" />
    <PackageVersion Include="Dapr.Actors" Version="1.18.4" />
    <PackageVersion Include="Dapr.Actors.AspNetCore" Version="1.18.4" />
    <PackageVersion Include="Dapr.AI" Version="1.18.4" />
    <PackageVersion Include="Dapr.AI.Microsoft.Extensions" Version="1.18.4" />
    <!-- Content Extraction -->
    <PackageVersion Include="Kreuzberg" Version="4.9.9" />
    <!-- Redis / FalkorDB -->
    <PackageVersion Include="NRedisStack" Version="1.6.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.0.47-preview" />
    <PackageVersion Include="NFalkorDB" Version="1.0.6" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Integration Testing -->
    <PackageVersion Include="Testcontainers" Version="4.12.0" />
    <!-- Story 7.5 Rev 1.3: Tier-2 WebApplicationFactory for trace-propagation + audit-log tests (no Docker). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <!-- Story 17.1: Fluent UI Blazor is pinned to the prerelease aligned with the Hexalith.FrontComposer
         submodule. The MCP documentation target 5.0.0.26098 is incompatible with the local package, so
         component API choices follow the submodule's pinned version. Bump only in lockstep with
         Hexalith.FrontComposer/Directory.Packages.props. -->
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0-rc.3-26138.1" />
    <!-- Story 17.1: bUnit 2.7.x is the version validated against the FrontComposer Testing
         host. Bump only after Hexalith.FrontComposer.Testing confirms compatibility, otherwise
         FrontComposerTestBase render setup breaks. -->
    <PackageVersion Include="bunit" Version="2.7.2" />
    <!-- CLI (Story 7.1): System.CommandLine is prerelease (3.0.0-preview) but is the Microsoft-supported
         CLI parser with first-class support for recursive/global options (Option.Recursive = true),
         async handlers with CancellationToken, and global-tool-friendly packaging. See ADR-7.1-008. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>
</Project>