<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Aspire 17 deprecates AddProject; keep the staged project model until a Project v2 migration. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.Memories.AccessTelemetry.Contracts\Hexalith.Memories.AccessTelemetry.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Memories.AccessTelemetry.Clock\Hexalith.Memories.AccessTelemetry.Clock.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Memories.AccessTelemetry\Hexalith.Memories.AccessTelemetry.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Memories.AppHost\Hexalith.Memories.AppHost.csproj">
      <IsAspireProjectResource>false</IsAspireProjectResource>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Hexalith.Memories.Server\Hexalith.Memories.Server.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Memories.Contracts\Hexalith.Memories.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Memories.Client.Rest\Hexalith.Memories.Client.Rest.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Memories.Cli\Hexalith.Memories.Cli.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Memories.Mcp\Hexalith.Memories.Mcp.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.TestHelpers\Hexalith.Memories.TestHelpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NFalkorDB" />
    <PackageReference Include="NRedisStack" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Hexalith.Memories.Server.Workflows.Contracts" />
    <Using Include="Hexalith.Memories.Server.Serialization" />
  </ItemGroup>

  <!-- Compile references from the same inventory the CI TRX verifier reads. -->
  <PropertyGroup>
    <IntegrationFastRequirementsFile Condition="'$(IntegrationFastRequirementsFile)' == ''">$(MSBuildThisFileDirectory)../../tools/integration-fast-required-surfaces.txt</IntegrationFastRequirementsFile>
  </PropertyGroup>
  <Target Name="CompileIntegrationFastSurfaceNames" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(IntegrationFastRequirementsFile)">
      <Output TaskParameter="Lines" ItemName="_IntegrationFastRequirement" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_IntegrationFastRequirement Remove="@(_IntegrationFastRequirement)"
        Condition="$([System.String]::Copy('%(Identity)').TrimStart().StartsWith('#'))" />
      <_IntegrationFastRequirement Update="@(_IntegrationFastRequirement)">
        <Symbol>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '^\s*[^|]+\|\s*([A-Za-z_]\w*(?:\.[A-Za-z_]\w*)+)(?:\s*\|\s*([A-Za-z_]\w*))?\s*$', '$1.$2').TrimEnd('.'))</Symbol>
      </_IntegrationFastRequirement>
    </ItemGroup>
    <Error Condition="'@(_IntegrationFastRequirement)' == ''" Text="No integration-fast surfaces found in $(IntegrationFastRequirementsFile)." />
    <Error Condition="'%(_IntegrationFastRequirement.Symbol)' == '%(_IntegrationFastRequirement.Identity)'"
      Text="Invalid integration-fast surface: %(_IntegrationFastRequirement.Identity)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)IntegrationFastSurfaceNames.g.cs"
      Lines="@(_IntegrationFastRequirement->'[assembly: global::System.Reflection.AssemblyMetadata(&quot;IntegrationFastSurface&quot;, nameof(global::%(Symbol)))]')"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)IntegrationFastSurfaceNames.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Qualification-only workflows do not use version discovery. Its generated public
       registry collides with the production Server registry imported by this assembly. -->
  <Target Name="RemoveQualificationWorkflowVersionRegistryGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Dapr.Workflow.Versioning.Generators'" />
    </ItemGroup>
  </Target>

</Project>
