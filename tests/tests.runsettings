<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    Shared coverage/runsettings used by the root test wrappers when coverage is enabled.
    Deliberately omits <TestSessionTimeout>: a session-wide cap was confusing (the prior 300 000 ms
    value matched neither its comment nor integration reality — 17 min) and duplicated job-level
    timeouts in .github/workflows/nightly.yml. Rely on per-test `[Fact(Timeout = ...)]` and CI
    job timeouts instead.
  -->

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Hexalith.Memories.*]*</Include>
          <Exclude>[*.Tests]*,[Hexalith.Memories.TestHelpers]*,[Hexalith.Memories.Web.Specimens]*,[Hexalith.Memories.MigrateEmbeddingVectors]*</Exclude>
          <ExcludeByFile>**/obj/**</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,ObsoleteAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <!-- Category filtering is owned by tools/test.sh and tools/test.ps1. Those wrappers
       translate VSTest Category expressions into Microsoft.Testing.Platform trait filters.
       Do not pass VSTest filter options to dotnet test. -->
</RunSettings>
