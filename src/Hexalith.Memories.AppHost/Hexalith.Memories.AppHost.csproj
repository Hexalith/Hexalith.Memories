<Project Sdk="Aspire.AppHost.Sdk/17.0.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <SkipAddAspireDefaultReferences>true</SkipAddAspireDefaultReferences>
    <SuppressAspireAppHostSdkObsoleteWarning>true</SuppressAspireAppHostSdkObsoleteWarning>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <NoWarn>$(NoWarn);ASPIRE012</NoWarn>
    <UserSecretsId>hexalith-memories</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Memories.AccessTelemetry.Clock\Hexalith.Memories.AccessTelemetry.Clock.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.AccessTelemetry\Hexalith.Memories.AccessTelemetry.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.Mcp\Hexalith.Memories.Mcp.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.Server\Hexalith.Memories.Server.csproj" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Aspire\Hexalith.EventStore.Aspire.csproj" IsAspireProjectResource="false" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- SkipAddAspireDefaultReferences avoids the SDK's implicit Versioned PackageReference, which CPM rejects. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Hexalith.EventStore.Aspire" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Memories.IntegrationTests" />
    <InternalsVisibleTo Include="Hexalith.Memories.Integration.NightlyTests" />
  </ItemGroup>

</Project>
