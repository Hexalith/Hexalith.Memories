<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Closed integration profile: ordinary native/publish builds retain their own source libraries. -->
    <MemoriesPublishedHostedTestProfile Condition="'$(HexalithUsePublishedSdkForHostedTests)' == 'true' and '$(IsPublishing)' != 'true'">true</MemoriesPublishedHostedTestProfile>
    <EnableContainer>true</EnableContainer>
    <ContainerRepository>memories</ContainerRepository>
    <!-- Story 9.2 Task 1.3 / Risk #1: Dapr.AI 1.17.6 marks ConverseAsync [Experimental("DAPR_CONVERSATION")];
         suppress this diagnostic locally so TreatWarningsAsErrors=true does not break the build.
         MUST remain scoped to this project — keep OUT of Directory.Build.props so any other project that
         accidentally takes a Dapr.AI dependency still fails fast. Remove when Dapr.AI exits alpha. -->
    <!-- EmbeddingClient owns provider retry/rate-limit semantics inside a durable workflow, so its
         named HttpClient removes the global resilience handler via the current extensions API. -->
    <NoWarn>$(NoWarn);DAPR_CONVERSATION;EXTEXP0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Include="..\..\deploy\dapr\components\conversation-llm.yaml"
             Link="deploy\dapr\components\conversation-llm.yaml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Memories.Server.Tests" />
    <InternalsVisibleTo Include="Hexalith.Memories.DerivedStores.Tests" />
    <InternalsVisibleTo Include="Hexalith.Memories.IntegrationTests" />
    <InternalsVisibleTo Include="Hexalith.Memories.Benchmarks" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <Using Include="Hexalith.Memories.Contracts.V1" />
    <Using Include="Hexalith.Memories.Server.Workflows.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Memories.AccessTelemetry.Contracts\Hexalith.Memories.AccessTelemetry.Contracts.csproj" />
    <ProjectReference Include="..\Hexalith.Memories.Contracts\Hexalith.Memories.Contracts.csproj" Condition="'$(MemoriesPublishedHostedTestProfile)' != 'true'" />
    <ProjectReference Include="..\Hexalith.Memories.EventStore\Hexalith.Memories.EventStore.csproj" Condition="'$(MemoriesPublishedHostedTestProfile)' != 'true'" />
    <ProjectReference
      Include="..\Hexalith.Memories.ServiceDefaults\Hexalith.Memories.ServiceDefaults.csproj" Condition="'$(MemoriesPublishedHostedTestProfile)' != 'true'" />
    <ProjectReference Include="..\Hexalith.Memories.Telemetry\Hexalith.Memories.Telemetry.csproj" Condition="'$(MemoriesPublishedHostedTestProfile)' != 'true'" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Client\Hexalith.EventStore.Client.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true' and '$(MemoriesPublishedHostedTestProfile)' != 'true'" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.DomainService\Hexalith.EventStore.DomainService.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true' and '$(MemoriesPublishedHostedTestProfile)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ByteAether.Ulid" />
    <PackageReference Include="Dapr.AspNetCore" />
    <PackageReference Include="Dapr.Client" />
    <PackageReference Include="Dapr.Workflow" />
    <PackageReference Include="Dapr.Actors" />
    <PackageReference Include="Dapr.Actors.AspNetCore" />
    <PackageReference Include="Dapr.AI" />
    <PackageReference Include="Dapr.AI.Microsoft.Extensions" />
    <PackageReference Include="Hexalith.EventStore.Client" Condition="'$(HexalithEventStoreFromSource)' != 'true' or '$(MemoriesPublishedHostedTestProfile)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.DomainService" Condition="'$(HexalithEventStoreFromSource)' != 'true' or '$(MemoriesPublishedHostedTestProfile)' == 'true'" />
    <PackageReference Include="Kreuzberg" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="NFalkorDB" />
    <PackageReference Include="NRedisStack" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <Import Project="Hexalith.Memories.Server.QualificationCurl.targets" />


  <ItemGroup Condition="'$(MemoriesPublishedHostedTestProfile)' == 'true'">
    <PackageReference Include="Hexalith.Memories.Contracts" />
    <PackageReference Include="Hexalith.Memories.EventStore" />
    <PackageReference Include="Hexalith.Memories.ServiceDefaults" />
    <PackageReference Include="Hexalith.Memories.Telemetry" />
  </ItemGroup>

  <Target Name="ValidatePublishedHostedTestProfile" BeforeTargets="PrepareForBuild" Condition="'$(MemoriesPublishedHostedTestProfile)' == 'true'">
    <Error Condition="'$(HexalithMemoriesVersion)' == '' or $([MSBuild]::VersionLessThan('$(HexalithMemoriesVersion)', '3.0.13'))"
           Text="The explicit hosted package profile requires an evaluated published Memories version3.0.13 or later." />
  </Target>

</Project>
