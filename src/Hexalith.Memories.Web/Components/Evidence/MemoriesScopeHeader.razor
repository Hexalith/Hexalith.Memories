@namespace Hexalith.Memories.Web.Components.Evidence
@inject IStringLocalizer<MemoriesWebResources> Localizer

@*
    Story 17.6 — scope captions use Fluent typography (FluentLabel) and FluentStack layout instead of
    hand-authored span weight (the removed .mem-evidence-label ramp) plus scoped flex CSS. The landmark
    <header>, the FcStatusBadge isolation chip, and the data-testid / accessible-name anchors that the
    Epic17 validation suite asserts are preserved; the <strong> value elements keep semantic emphasis.
*@

<header class="mem-evidence-scope"
        data-testid="mem-evidence-scope"
        aria-label="@Localizer[EvidenceResourceKeys.ScopeLabel]">
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
            <FluentLabel Size="LabelSize.Small">@Localizer[EvidenceResourceKeys.TenantLabel]</FluentLabel>
            <FluentLabel Size="LabelSize.Medium" Weight="LabelWeight.Semibold">
                <strong data-testid="mem-scope-tenant">@TenantText</strong>
            </FluentLabel>
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
            <FluentLabel Size="LabelSize.Small">@Localizer[EvidenceResourceKeys.CaseLabel]</FluentLabel>
            <FluentLabel Size="LabelSize.Medium" Weight="LabelWeight.Semibold">
                <strong data-testid="mem-scope-case">@(EvidenceDisplay.SafeText(Packet.Scope.CaseId, Localizer[EvidenceResourceKeys.TenantScope]))</strong>
            </FluentLabel>
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
            <FluentLabel Size="LabelSize.Small">@Localizer[EvidenceResourceKeys.PermissionsLabel]</FluentLabel>
            <FluentLabel Size="LabelSize.Medium" Weight="LabelWeight.Semibold">
                <strong data-testid="mem-scope-permissions">@Localizer[PermissionsKey]</strong>
            </FluentLabel>
        </FluentStack>
        <div data-testid="mem-scope-isolation">
            <FcStatusBadge Slot="@EvidenceDisplay.SlotForIsolation(Packet.Scope.IsolationStatus)"
                           Label="@EvidenceDisplay.Label(Packet.Scope.IsolationStatus, Localizer)"
                           ColumnHeader="@Localizer[EvidenceResourceKeys.ScopeColumn]" />
        </div>
    </FluentStack>
</header>

@code {
    [Parameter]
    [EditorRequired]
    public EvidencePacket Packet { get; set; } = default!;

    private string PermissionsKey => Packet.Scope.PermissionsContext switch
    {
        EvidencePacketPermissionsContext.Tenant when HasAuthorizedScope && string.IsNullOrWhiteSpace(Packet.Scope.CaseId)
            => EvidenceResourceKeys.TenantPermissions,
        EvidencePacketPermissionsContext.TenantCase when HasAuthorizedScope && !string.IsNullOrWhiteSpace(Packet.Scope.CaseId)
            => EvidenceResourceKeys.CasePermissions,
        EvidencePacketPermissionsContext.McpAuthorization => EvidenceResourceKeys.McpAuthorizationPermissions,
        EvidencePacketPermissionsContext.McpError => EvidenceResourceKeys.McpErrorPermissions,
        _ => EvidenceResourceKeys.Unavailable,
    };

    private bool HasAuthorizedScope => Packet.Scope.IsolationStatus == EvidencePacketIsolationStatus.Authorized
        && Packet.State != EvidencePacketState.Unauthorized
        && Packet.OmittedDetails.Reason != EvidencePacketOmissionReason.Authorization;

    private string TenantText => Packet.Scope.IsolationStatus == EvidencePacketIsolationStatus.Unknown
        && string.Equals(Packet.Scope.TenantId, "unknown", StringComparison.Ordinal)
            ? Localizer[EvidenceResourceKeys.UnknownTenant]
            : EvidenceDisplay.SafeText(Packet.Scope.TenantId, Localizer[EvidenceResourceKeys.UnknownTenant]);
}
