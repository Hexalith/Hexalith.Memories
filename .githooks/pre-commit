#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
git_dir="$(git rev-parse --git-dir)"
cd "$repo_root"

branch_name="$(git branch --show-current)"
changed_file="$git_dir/story-scope-changed-$$.txt"
trap 'rm -f "$changed_file"' EXIT

git diff --cached --name-only -- > "$changed_file"

if command -v python3 >/dev/null 2>&1; then
  python3 tools/check-story-file-scope.py --branch-name "$branch_name" --changed-files-file "$changed_file"
else
  python tools/check-story-file-scope.py --branch-name "$branch_name" --changed-files-file "$changed_file"
fi
