diff --git a/tests/Hexalith.Memories.Server.Tests/Hosting/OrphanSemanticIndexReconcilerTests.cs b/tests/Hexalith.Memories.Server.Tests/Hosting/OrphanSemanticIndexReconcilerTests.cs
new file mode 100644
index 0000000..ce862bc
