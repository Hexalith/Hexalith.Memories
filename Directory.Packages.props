<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Define paths of the Hexalith packages props. -->
    <Hexalith1BuildPackageProps>$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props</Hexalith1BuildPackageProps>
    <Hexalith2BuildPackageProps>$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props</Hexalith2BuildPackageProps>
    <Hexalith3BuildPackageProps>$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/Directory.Packages.props</Hexalith3BuildPackageProps>
  </PropertyGroup>
  <!-- Import the required Hexalith.Packages.props file. -->
  <Import Project="$(Hexalith1BuildPackageProps)" Condition="Exists('$(Hexalith1BuildPackageProps)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(Hexalith2BuildPackageProps)" Condition="Exists('$(Hexalith2BuildPackageProps)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(Hexalith3BuildPackageProps)" Condition="'$(HexalithVersionsLoaded)' != 'true'" />
  <!-- Owner release prerequisite: keep newer central selections while requiring the delivered catalog SDK. -->
  <PropertyGroup>
    <HexalithEventStoreVersion Condition="'$(HexalithEventStoreFromSource)' != 'true' and ('$(HexalithEventStoreVersion)' == '' or $([MSBuild]::VersionLessThan('$(HexalithEventStoreVersion)', '3.129.0')))">3.129.0</HexalithEventStoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Update="Hexalith.EventStore.*" Version="$(HexalithEventStoreVersion)" />
  </ItemGroup>
  <!-- Existing public compatibility packages are consumed only by the explicit hosted-test profile. -->
  <ItemGroup Condition="'$(HexalithUsePublishedSdkForHostedTests)' == 'true' and '$(IsPublishing)' != 'true'">
    <PackageVersion Include="Hexalith.Memories.ServiceDefaults" Version="$(HexalithMemoriesVersion)" Condition="'@(PackageVersion->WithMetadataValue('Identity', 'Hexalith.Memories.ServiceDefaults'))' == ''" />
    <PackageVersion Include="Hexalith.Memories.Telemetry" Version="$(HexalithMemoriesVersion)" Condition="'@(PackageVersion->WithMetadataValue('Identity', 'Hexalith.Memories.Telemetry'))' == ''" />
  </ItemGroup>
</Project>
