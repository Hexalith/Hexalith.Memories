<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Hexalith.Memories.Redis</PackageId>
    <Description>Compatibility-only Redis and FalkorDB API surface retained for existing Hexalith.Memories consumers. New code should reference NFalkorDB, NRedisStack, and StackExchange.Redis directly.</Description>
    <Authors>ITANEO</Authors>
    <Company>ITANEO</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Memories</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Memories</RepositoryUrl>
    <PackageTags>hexalith;memories;redis;falkordb;compatibility;deprecated</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NRedisStack" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="NFalkorDB" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
